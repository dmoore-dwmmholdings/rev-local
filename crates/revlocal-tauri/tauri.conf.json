{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rev-local",
  "version": "0.1.0",
  "identifier": "com.dwmmholdings.revlocal",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": "npm ci && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rev-local",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first automated code review",
    "longDescription": "rev-local watches your repositories, reviews changes with a coding agent you already have installed, and publishes findings only as far as you allow.",
    "copyright": "",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
